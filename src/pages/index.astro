---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NoteCta from '../components/NoteCta.astro';
import { SERIES, url } from '../config';
import { getArticles } from '../lib/articles';
const articles = (await getArticles()).slice(0, 6);
---
<Base>
  <section class="hero">
    <h1>教室でつまずくポイントを、<br /><span class="marker">先生のノート</span>にまとめました。</h1>
    <p>台湾で2年間、日本語を教えてきました。N5〜N3の文法を中心に、教科書だけでは分からない「教え方」と「学習者の間違い」を紹介します。</p>
  </section>

  <section class="section">
    <h2 class="section-title">新着記事</h2>
    {articles.length
      ? <div class="cards">{articles.map((a) => <ArticleCard article={a} />)}</div>
      : <p class="empty">記事は準備中です。もうしばらくお待ちください。</p>}
    <a class="more" href={url('articles/')}>記事をすべて見る →</a>
  </section>

  <section class="section">
    <h2 class="section-title">シリーズ</h2>
    <ul class="series-list">
      {SERIES.map((s) => (
        <li><a href={url(`articles/?series=${s.id}`)}><strong>{s.name}</strong><span>{s.desc}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">このサイトを書いている人</h2>
    <div class="sheet profile-mini">
      <div class="avatar" aria-hidden="true">🍡</div>
      <div>
        <p><strong>おもち</strong>　日本語教師</p>
        <p>台湾で2年間、日本語を教えました。教室で実際に見た間違いと、うまくいった教え方を記録しています。</p>
        <a href={url('profile/')}>プロフィールを読む →</a>
      </div>
    </div>
  </section>

  <NoteCta />
</Base>
