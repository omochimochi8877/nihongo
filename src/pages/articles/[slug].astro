---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NoteCta from '../../components/NoteCta.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE, seriesName, url } from '../../config';
import { getArticles, slugOf } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  const zh = await getArticles('zh-tw');
  // ユニット順の並び（前後のユニットへのリンク用）
  const byUnit = articles
    .filter((a) => a.data.unit)
    .sort((a, b) => a.data.unit! - b.data.unit! || (a.data.order ?? 99) - (b.data.order ?? 99));
  return articles.map((article) => ({
    params: { slug: slugOf(article.id) },
    props: {
      article,
      related: articles.filter((a) => a.id !== article.id && a.data.series === article.data.series).slice(0, 3),
      hasZh: zh.some((z) => slugOf(z.id) === slugOf(article.id)),
      prev: byUnit[byUnit.indexOf(article) - 1],
      next: byUnit.indexOf(article) >= 0 ? byUnit[byUnit.indexOf(article) + 1] : undefined,
    },
  }));
}
const { article, related, hasZh, prev, next } = Astro.props;
const zhUrl = hasZh ? url(`zh-tw/articles/${slugOf(article.id)}/`) : undefined;
const d = article.data;
const { Content } = await render(article);
const fmt = (x: Date) => x.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'ja',
  image: new URL(d.image ?? url('og.png'), Astro.site).toString(),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  author: { '@type': 'Person', name: SITE.author, url: new URL(url('profile/'), Astro.site).toString() },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL(url('og.png'), Astro.site).toString() } },
};
---
<Base title={d.title} description={d.description} image={d.image} type="article" noindex={d.draft} alt={zhUrl}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Breadcrumbs items={[{ name: 'トップ', href: url('') }, { name: '記事一覧', href: url('articles/') }, { name: d.title }]} />
  <article class="sheet">
    <header class="article-head">
      <div class="card-tags">
        <a class="tag tag-series" href={url(`articles/?series=${d.series}`)}>{seriesName(d.series)}</a>
        {d.levels.map((l) => <a class="tag tag-level" href={url(`articles/?level=${l}`)}>{l}</a>)}
        {d.unit && <a class="tag tag-unit" href={url('syllabus/')}>ユニット{d.unit}</a>}
        {d.draft && <span class="tag tag-draft">下書き（公開されません）</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="meta">
        <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>
        {d.updated && <> ・ 更新 <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}
      </p>
      {zhUrl && <p class="lang-switch"><a href={zhUrl} lang="zh-Hant-TW">中文版（學生用）→</a></p>}
    </header>
    <div class="prose"><Content /></div>
    <AdSlot />
    {(prev || next) && (
      <nav class="unit-nav" aria-label="ユニット">
        {prev ? <a href={url(`articles/${slugOf(prev.id)}/`)}>← ユニット{prev.data.unit}</a> : <span />}
        {next ? <a href={url(`articles/${slugOf(next.id)}/`)}>ユニット{next.data.unit} →</a> : <span />}
      </nav>
    )}
    <NoteCta href={d.noteUrl} />
  </article>
  {related.length > 0 && (
    <section class="related">
      <h2 class="section-title">同じシリーズの記事</h2>
      <div class="cards">{related.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}
</Base>
